# ---------------------------------------------------------------------------
# stock_trading_agent configuration
# Copy to ".env" and fill in values. ALL of these are OPTIONAL.
# With no keys set, the system runs in fully offline "heuristic" mode.
# ---------------------------------------------------------------------------

# Which LLM backend to use: "offline" | "openai" | "anthropic"
STA_LLM_PROVIDER=offline

# Model name for the chosen provider (ignored in offline mode)
# openai example:    gpt-4o-mini
# anthropic example: claude-3-5-sonnet-latest
STA_LLM_MODEL=gpt-4o-mini

# Sampling temperature for agent reasoning
STA_LLM_TEMPERATURE=0.3

# Provider credentials (only needed for the matching provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Market data source: "synthetic" (no network) | "yfinance"
STA_DATA_SOURCE=synthetic

# Where to persist agent reflection memory
STA_MEMORY_PATH=runs/memory.json

# Verbosity of the debate / pipeline logs
STA_VERBOSE=true
